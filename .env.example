# GARY environment variables
# Copy this file to .env and fill in values. Do not commit real credentials.

# Google Cloud project ID for Batch jobs (required for cloud operations)
# GARY_GCP_PROJECT=your-project-id

# Google Cloud region for Batch jobs (required for cloud operations)
# GARY_GCP_REGION=us-central1

# Google Cloud zone (optional, overrides region default)
# GARY_GCP_ZONE=us-central1-a

# GitHub repository in owner/repo format (optional)
# GARY_GITHUB_REPO=owner/repo

# GitHub App credentials for private-repository control-plane operations.
# The installation token is minted for the exact trusted-owner repository per job.
# GARY_GITHUB_APP_ID=your-app-id
# GARY_GITHUB_APP_INSTALLATION_ID=your-installation-id
# GARY_GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----..."

# Local results directory (defaults to ./results)
# GARY_RESULTS_DIR=./results

# Default worker runtime: batch or managed (defaults to batch)
# GARY_WORKER_RUNTIME=batch

# Durable project context root (defaults to ./gary/projects)
# GARY_PROJECTS_DIR=./gary/projects

# Local Luna Yardmaster prototype settings.
# GARY_YARDMASTER_MODEL=gpt-5.6-luna
# GARY_STATE_DIR=./.gary-state
# Canonical local front-door state root (defaults to %USERPROFILE%\.gary)
# GARY_STATE_ROOT=C:\Users\you\.gary
# MiMo Token Plan is process-injected; never commit the key.
# MIMO_API_KEY=tp-...
# GARY_MIMO_BASE_URL=https://token-plan-ams.xiaomimimo.com/v1
# Set only for explicit legacy Batch diagnostics/experiments.
# GARY_ENABLE_BATCH=0
