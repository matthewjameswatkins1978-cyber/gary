{
  "schema": "gary.project-manual.v1",
  "project_id": "telltail-v03-fresh-r2",
  "objective": "Build and verify canonical Telltail 0.3.0: an idiomatic Go CLI (`telltail`) that executes and evaluates synthetic AI worker shifts locally and in Google Cloud Batch, records SHA-256 hash-chained observable JSONL trajectories, runs deterministic behavioural detectors and profilers, builds Worker Dossiers, runs the recursive Mirror Shift evaluation challenge, and executes a real remote cloud canary.",
  "definition_of_done": "Complete Go codebase on an isolated staging branch passing go test, go vet, cross-platform build smoke (Linux and Windows amd64), local run trace verification smoke, mirror init smoke, cloud job-spec smoke, live GCP Batch remote execution canary evidence, and diagnostic documentation at docs/GARY-FIRST-SHIFT.md.",
