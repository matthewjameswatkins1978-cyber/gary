{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gary.agent-yard.local/schema/gary-acceptance-contract-v1.schema.json",
  "title": "GARY Acceptance Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "source_packet_digest",
    "contract_version",
    "claims",
    "contract_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "project_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,59}$" },
    "source_packet_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "contract_version": { "type": "integer", "minimum": 1 },
    "contract_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "statement",
          "importance",
          "boundary",
          "evidence_expectation",
          "status",
          "source"
        ],
        "properties": {
          "claim_id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "importance": { "enum": ["required", "advisory"] },
          "boundary": { "type": "string", "minLength": 1 },
          "evidence_expectation": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["packet_digest", "locator"],
            "properties": {
              "packet_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "locator": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
