{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gary.project-feedback-event.v1",
  "type": "object",
  "required": [
    "schema", "event_id", "event_type", "event_digest", "feedback_id",
    "project_id", "actor", "created_at", "scope", "text", "status"
  ],
  "properties": {
    "schema": {"const": "gary.project-feedback-event.v1"},
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["submitted", "applied"]},
    "previous_event_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "event_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "feedback_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,59}$"},
    "actor": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "scope": {"enum": ["note", "project_preference", "project_correction", "propose_doctrine"]},
    "decision_reference": {"type": "string"},
    "child_task_id": {"type": "string"},
    "text": {"type": "string", "minLength": 1},
    "status": {"enum": ["RECORDED", "PENDING_SAFE_BOUNDARY", "APPLIED"]},
    "applied_at": {"type": "string"},
    "applied_boundary": {"type": "string"}
  },
  "additionalProperties": false
}
