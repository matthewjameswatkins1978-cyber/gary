{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gary.project-lifecycle-event.v1",
  "type": "object",
  "required": [
    "schema", "event_id", "event_digest", "project_id", "generation",
    "new_state", "actor", "reason", "created_at"
  ],
  "properties": {
    "schema": {"const": "gary.project-lifecycle-event.v1"},
    "event_id": {"type": "string", "minLength": 1},
    "event_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "previous_event_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,59}$"},
    "generation": {"type": "integer", "minimum": 1},
    "previous_state": {"enum": ["", "ACTIVE", "PARKED", "WAITING", "BLOCKED", "ACCEPTED", "CANCELLED"]},
    "new_state": {"enum": ["ACTIVE", "PARKED", "WAITING", "BLOCKED", "ACCEPTED", "CANCELLED"]},
    "actor": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "created_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}